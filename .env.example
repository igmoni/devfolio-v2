
# Website & General
SITE_URL=http://localhost:3000

# Database (Prisma + PostgreSQL for Sponsors)
DATABASE_URL=postgresql://user:password@localhost:5432/devfolio?schema=public

# Spotify API (Now Playing & Recently Played)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# WakaTime (Live Coding Status)
WAKATIME_OAUTH_TOKEN=
WAKATIME_TIMEZONE=Asia/Kolkata
WAKATIME_ONLINE_THRESHOLD_SECONDS=180

# GitHub API (Optional: increases rate limits for repo stats)
GITHUB_TOKEN=

# Dodo Payments (Sponsor Wall & One-time Seats)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode   # test_mode or live_mode
DODO_PRODUCT_ID=pdt_xxxxxxxx
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/sponsor/claim
DODO_PAYMENTS_WEBHOOK_KEY=

# Vercel Blob Storage (Sponsor Logo & Image Uploads)
BLOB_READ_WRITE_TOKEN=

# Vercel Web Analytics API (for Insights chart & Total Visitors pill)
VERCEL_TOKEN_ID=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Umami Analytics (Alternative Privacy-friendly Analytics)
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_ID=
UMAMI_SRC=
UMAMI_ID=

# Resend Contact Form
RESEND_API_KEY=
CONTACT_EMAIL=example@gmail.com
RESEND_FROM_EMAIL=Devfolio Contact <onboarding@resend.dev>

# Geo Proxy (Optional: Notra Analytics)
NOTRA_GEO_TOKEN=
